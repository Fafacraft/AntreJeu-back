  "type": "module",
  "main": "./src/app.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "tsx --watch ./src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
